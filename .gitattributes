# Normalise line endings to LF on commit, check out as LF on all platforms.
# This prevents the most common source of spurious merge conflicts.
* text=auto eol=lf

# Windows-only scripts may need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files — no diff, no merge
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary

# Lock files should not be merged — always use the version being merged in
package-lock.json merge=ours
